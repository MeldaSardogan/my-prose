<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- Daten deines eigenen Projekts -->
  <groupId>de.htw_berlin.fb4.ossd.melda</groupId>
<artifactId>my-prose</artifactId>
  <packaging>jar</packaging>

<name>My Prose</name>
<url>https://github.com/MeldaSardogan/my-prose</url>  <version>1.0.0</version>  <description>
    A Maven application that combines sentences using prose-builder.
  </description>


<developers>
    <developer>
        <id>MeldaSardogan</id>
        <name>MeldaSardogan</name>
        <roles>
            <role>Developer</role>
        </roles>
    </developer>
</developers>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Das Arbeitsblatt verwendet Java 21. -->
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Versionen der Abhängigkeiten -->
    <prose-builder.version>1.0-0</prose-builder.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <!-- GitHub Packages Repository des Dozenten -->
  <repositories>
    <repository>
      <!-- Muss zur ID in ~/.m2/settings.xml passen. -->
      <id>prose-builder</id>
      <name>Prose Builder GitHub Packages</name>
      <url>https://maven.pkg.github.com/bs-jokri/prose-builder</url>

      <releases>
        <enabled>true</enabled>
      </releases>

      <!-- Notwendig für 1.0-SNAPSHOT -->
      <snapshots>
        <enabled>true</enabled>
        <updatePolicy>always</updatePolicy>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- Bibliothek aus dem Arbeitsblatt -->
    <dependency>
      <groupId>de.htw_berlin.fb4.ossd</groupId>
      <artifactId>prose_builder</artifactId>
      <version>${prose-builder.version}</version>
    </dependency>

    <!-- Tests für Aufgabe 4 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Java-Code kompilieren -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- JUnit-5-Tests ausführen -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- App über mvn exec:java starten -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>

        <configuration>
          <mainClass>de.htw_berlin.fb4.ossd.melda.App</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

<distributionManagement>
    <repository>
        <id>github</id>
        <name>GitHub Packages</name>
        <url>https://maven.pkg.github.com/MeldaSardogan/my-prose</url>
    </repository>
</distributionManagement>

</project>